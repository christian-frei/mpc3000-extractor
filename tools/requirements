#!/usr/bin/env -S java --source 25

String name = MethodHandles.lookup().lookupClass().getName();
String version = "2026-11-06.1";

/// One EARS statement: `/// - R1.2 — <text>` with an optional trailing `_(why: …)_`
Pattern statement = Pattern.compile("^/// - (R\\d+\\.\\d+) — (.*?)(?: _\\(why:.*\\)_)?$");
Pattern packageName = Pattern.compile("^package ([\\w.]+);$");

void main(String... args) throws Exception {
    IO.println(name + " " + version);
    if (args.length == 0 || args[0].equals("help")) {
        IO.println("""
                Usage: %s <bc-folder>...
                  Regenerates Requirement.java in each business component folder from its package-info.java spec
                  help     Show this help
                  version  Show version""".formatted(name));
        return;
    }
    if (args[0].equals("version"))
        return;
    for (var folder : args)
        generate(Path.of(folder));
}

void generate(Path folder) throws IOException {
    var spec = Files.readAllLines(folder.resolve("package-info.java"));
    var pkg = spec.stream()
            .map(packageName::matcher)
            .filter(Matcher::matches)
            .map(m -> m.group(1))
            .findFirst()
            .orElseThrow(() -> new IllegalArgumentException("no package declaration in " + folder));
    var constants = spec.stream()
            .map(statement::matcher)
            .filter(Matcher::matches)
            .map(m -> constant(m.group(1), m.group(2)))
            .toList();
    Files.writeString(folder.resolve("Requirement.java"), source(pkg, String.join(",\n", constants) + ";"));
    IO.println("%s: %d statement(s)".formatted(pkg, constants.size()));
}

String constant(String id, String text) {
    var escaped = text.replace("\\", "\\\\").replace("\"", "\\\"");
    return "        /// %s\n        %s(\"%s\", \"%s\")".formatted(text, id.replace('.', '_'), id, escaped);
}

String source(String pkg, String constants) {
    return """
            package %1$s;

            import java.lang.annotation.Documented;
            import java.lang.annotation.ElementType;
            import java.lang.annotation.Retention;
            import java.lang.annotation.RetentionPolicy;
            import java.lang.annotation.Target;

            /// Generated from the capability spec in [%1$s] — do not edit.
            /// Marks the boundary method or test that realizes the given requirement statements.
            @Documented
            @Target(ElementType.METHOD)
            @Retention(RetentionPolicy.RUNTIME)
            public @interface Requirement {

                /// One constant per statement id in the spec's `## Requirements`.
                enum Rn {
            %2$s

                    private final String id;
                    private final String statement;

                    Rn(String id, String statement) {
                        this.id = id;
                        this.statement = statement;
                    }

                    public String statement() {
                        return statement;
                    }

                    @Override
                    public String toString() {
                        return id;
                    }
                }

                Rn[] value();
            }
            """.formatted(pkg, constants);
}
